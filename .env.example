# Listen address
LISTEN_ADDR=0.0.0.0:3000

# Gemini authentication (use one)
GEMINI_API_KEY=
GEMINI_COOKIES=

# Optional: protect proxy endpoint with bearer token
AUTH_TOKEN=

# Default model when none specified
DEFAULT_MODEL=gemini-2.5-flash

# Max retry attempts
MAX_RETRIES=2

# Gemini API base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
